{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CrossPlatformFormMigrationSchema",
  "description": "Schema for capturing custom form structures, section-level display/skip logic, and data mappings between configurable source and target systems.",
  "type": "object",
  "required": ["formId", "formTitle", "sourceSystem", "targetSystem", "sections"],
  "properties": {
    "formId": { "type": "string" },
    "formTitle": { "type": "string" },
    "description": { "type": "string" },
    "sourceSystem": { "type": "string" },
    "targetSystem": { "type": "string" },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/definitions/FormSection" }
    }
  },
  "definitions": {
    "FormSection": {
      "type": "object",
      "required": ["sectionId", "title", "fields"],
      "properties": {
        "sectionId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "displayLogic": { "$ref": "#/definitions/SectionLogicRule" },
        "skipLogic": { "$ref": "#/definitions/SectionLogicRule" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/FormField" }
        },
        "subsections": {
          "type": "array",
          "description": "Nested sections (recursive). Each subsection has its own fields, display/skip logic, and may contain further subsections. Logic conditions may reference any field that appears earlier in document order, including the parent's fields and earlier siblings' fields.",
          "items": { "$ref": "#/definitions/FormSection" },
          "default": []
        }
      }
    },
    "SectionLogicRule": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "junction": { "type": "string", "enum": ["AND", "OR"], "default": "AND" },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["controllingFieldId", "controllingFieldName", "operator"],
            "properties": {
              "controllingFieldId": { "type": "string" },
              "controllingFieldName": { "type": "string" },
              "operator": {
                "type": "string",
                "enum": ["equals", "notEquals", "contains", "doesNotContain", "isEmpty", "isNotEmpty"]
              },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "FormField": {
      "type": "object",
      "required": ["fieldId", "name", "title", "dataType", "sourceMapping", "destinationMapping"],
      "properties": {
        "fieldId": { "type": "string" },
        "name": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "dataType": {
          "type": "object",
          "required": ["sourceType", "targetType"],
          "properties": {
            "sourceType": { "type": "string" },
            "targetType": { "type": "string" }
          }
        },
        "sourceMapping": { "$ref": "#/definitions/DataEndpoint" },
        "destinationMapping": { "$ref": "#/definitions/DataEndpoint" }
      }
    },
    "DataEndpoint": {
      "type": "object",
      "required": ["databaseId", "databaseName", "tableId", "tableName", "fieldId", "fieldName"],
      "properties": {
        "databaseId": { "type": "string" },
        "databaseName": { "type": "string" },
        "tableId": { "type": "string" },
        "tableName": { "type": "string" },
        "fieldId": { "type": "string" },
        "fieldName": { "type": "string" }
      }
    }
  }
}